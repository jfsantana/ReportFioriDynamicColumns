<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:smartfilterbar="sap.ui.comp.smartfilterbar">

    <!--
        Filtro personalizado "Tipo de Impuesto" (V = Input Tax, A = Output Tax).
        NO es un parametro del servicio: solo decide, en la app, que filas de
        TablaParametros se usan para nombrar/mostrar las columnas c1..c9.
        Los valores y descripciones vienen de la entidad I_TaxType.
    -->
    <smartfilterbar:ControlConfiguration
        key="CustomTaxType"
        groupId="_BASIC"
        label="{i18n>taxTypeFilterLabel}"
        visibleInAdvancedArea="true">
        <smartfilterbar:customControl>
            <Select
                id="taxTypeSelect"
                forceSelection="true"
                selectedKey="V"
                items="{ path: '/I_TaxType', templateShareable: false }">
                <core:Item
                    key="{TaxType}"
                    text="{TaxType_Text} ({TaxType})"/>
            </Select>
        </smartfilterbar:customControl>
    </smartfilterbar:ControlConfiguration>

</core:FragmentDefinition>
