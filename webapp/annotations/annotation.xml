<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx"
           Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1"
                      Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1"
                      Alias="UI"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm"
                Namespace="local">

            <!-- ============================================================ -->
            <!-- Entidad de resultados: filtros + columnas del reporte        -->
            <!-- ============================================================ -->
            <Annotations Target="cds_ymqaf_sd_taxrpt_enriched.TaxReportEnrichedType">

                <!-- FILTROS: Sociedad y Ejercicio ya salen como parametros
                     obligatorios del servicio (considerAnalyticalParameters),
                     por eso NO se listan en UI.SelectionFields: duplicaria
                     los campos. El Tipo de Impuesto es siempre V (sin filtro).
                     Filtros opcionales (en este orden): Nº Documento,
                     Periodo fiscal (FiscalPeriod), Fecha de documento
                     (DocumentDate = "Journal Entry Date"), Fecha de
                     contabilizacion, Proveedor y Clase de documento
                     (AccountingDocumentType = "Journal Entry Type").
                     PENDIENTE: Tax Code no existe en el servicio (la vista
                     ENRICHED agrupa por documento y no expone TaxCode). -->
                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>AccountingDocument</PropertyPath>
                        <PropertyPath>FiscalPeriod</PropertyPath>
                        <PropertyPath>DocumentDate</PropertyPath>
                        <PropertyPath>PostingDate</PropertyPath>
                        <PropertyPath>Supplier</PropertyPath>
                        <PropertyPath>AccountingDocumentType</PropertyPath>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.HeaderInfo">
                    <Record Type="UI.HeaderInfoType">
                        <PropertyValue Property="TypeName"
                                       String="Libro de Compras"/>
                        <PropertyValue Property="TypeNamePlural"
                                       String="Libro de Compras"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value"
                                               Path="AccountingDocument"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>

                <!-- TABLA: Columnas del reporte (C01..C15 se renombran dinamicamente) -->
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <!-- Orden del Libro de Compras (el "#" correlativo solo existe en el PDF) -->
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="DocumentDate"/>
                            <PropertyValue Property="Label" String="DÍA"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="TipDocSat"/>
                            <PropertyValue Property="Label" String="TIPO"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Serie"/>
                            <PropertyValue Property="Label" String="SERIE"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="DocumentReferenceID"/>
                            <PropertyValue Property="Label" String="NO. DOCUMENTO"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Nit"/>
                            <PropertyValue Property="Label" String="NIT"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Proveedor"/>
                            <PropertyValue Property="Label" String="PROVEEDOR"/>
                        </Record>
                        <!-- Columnas dinamicas (se renombran/ocultan segun TablaParametros) -->
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C01"/>
                            <PropertyValue Property="Label" String="C01"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C02"/>
                            <PropertyValue Property="Label" String="C02"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C03"/>
                            <PropertyValue Property="Label" String="C03"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C04"/>
                            <PropertyValue Property="Label" String="C04"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C05"/>
                            <PropertyValue Property="Label" String="C05"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C06"/>
                            <PropertyValue Property="Label" String="C06"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C07"/>
                            <PropertyValue Property="Label" String="C07"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C08"/>
                            <PropertyValue Property="Label" String="C08"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C09"/>
                            <PropertyValue Property="Label" String="C09"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C10"/>
                            <PropertyValue Property="Label" String="C10"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C11"/>
                            <PropertyValue Property="Label" String="C11"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C12"/>
                            <PropertyValue Property="Label" String="C12"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C13"/>
                            <PropertyValue Property="Label" String="C13"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C14"/>
                            <PropertyValue Property="Label" String="C14"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C15"/>
                            <PropertyValue Property="Label" String="C15"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="ImporteIVA"/>
                            <PropertyValue Property="Label" String="IVA"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Total"/>
                            <PropertyValue Property="Label" String="TOTAL"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="NoProveedor"/>
                            <PropertyValue Property="Label" String="No. PROVEEDOR"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="AccountingDocument"/>
                            <PropertyValue Property="Label" String="Nro. Documento FI"/>
                        </Record>
                    </Collection>
                </Annotation>
            </Annotations>

            <!-- Etiqueta del filtro/columna Nº Documento -->
            <Annotations Target="cds_ymqaf_sd_taxrpt_enriched.TaxReportEnrichedType/AccountingDocument">
                <Annotation Term="Common.Label" String="Nº Documento"/>
            </Annotations>

            <!-- TIPO: muestra el codigo SAT con su descripcion ("FACTURA (FACT)") -->
            <Annotations Target="cds_ymqaf_sd_taxrpt_enriched.TaxReportEnrichedType/TipDocSat">
                <Annotation Term="Common.Text" Path="DescTipoDocumento">
                    <Annotation Term="UI.TextArrangement" EnumMember="UI.TextArrangementType/TextFirst"/>
                </Annotation>
            </Annotations>

            <!-- Las copias "normales" de los parametros (columnas clave de la
                 entidad de resultados) no deben ofrecerse como filtros. -->
            <Annotations Target="cds_ymqaf_sd_taxrpt_enriched.TaxReportEnrichedType/P_CompanyCode">
                <Annotation Term="UI.HiddenFilter" Bool="true"/>
            </Annotations>
            <Annotations Target="cds_ymqaf_sd_taxrpt_enriched.TaxReportEnrichedType/P_FiscalYear">
                <Annotation Term="UI.HiddenFilter" Bool="true"/>
            </Annotations>

        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
