<edmx:Edmx xmlns:edmx="http://docs.oasis-open.org/odata/ns/edmx"
           Version="4.0">
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/Common.xml">
        <edmx:Include Namespace="com.sap.vocabularies.Common.v1"
                      Alias="Common"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/UI.xml">
        <edmx:Include Namespace="com.sap.vocabularies.UI.v1"
                      Alias="UI"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://oasis-tcs.github.io/odata-vocabularies/vocabularies/Org.OData.Capabilities.V1.xml">
        <edmx:Include Namespace="Org.OData.Capabilities.V1"
                      Alias="Capabilities"/>
    </edmx:Reference>
    <edmx:Reference Uri="https://sap.github.io/odata-vocabularies/vocabularies/HTML5.xml">
        <edmx:Include Namespace="com.sap.vocabularies.HTML5.v1"
                      Alias="HTML5"/>
    </edmx:Reference>
    <edmx:DataServices>
        <Schema xmlns="http://docs.oasis-open.org/odata/ns/edm"
                Namespace="local">

            <!-- ============================================================ -->
            <!-- Periodo contable OBLIGATORIO y de valor unico: el PDF del    -->
            <!-- backend (accion generarPdf) se genera por un solo periodo.   -->
            <!-- ============================================================ -->
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.cds_ymqaf_sb_taxrpt_enrich_v2_Entities/TaxReportEnrichedSet">
                <Annotation Term="Capabilities.FilterRestrictions">
                    <Record Type="Capabilities.FilterRestrictionsType">
                        <PropertyValue Property="RequiredProperties">
                            <Collection>
                                <PropertyPath>FiscalPeriod</PropertyPath>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="FilterExpressionRestrictions">
                            <Collection>
                                <Record Type="Capabilities.FilterExpressionRestrictionType">
                                    <PropertyValue Property="Property" PropertyPath="FiscalPeriod"/>
                                    <PropertyValue Property="AllowedExpressions" String="SingleValue"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- ============================================================ -->
            <!-- Entidad de resultados: filtros + columnas del reporte        -->
            <!-- ============================================================ -->
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.TaxReportEnrichedType">

                <!-- FILTROS: Sociedad y Ejercicio ya salen como parametros
                     obligatorios del servicio (considerAnalyticalParameters),
                     por eso NO se listan en UI.SelectionFields: duplicaria
                     los campos. El Tipo de Impuesto es siempre V (sin filtro).
                     Filtros (en este orden): Nº Documento,
                     Periodo fiscal (FiscalPeriod, OBLIGATORIO), Fecha de documento
                     (DocumentDate = "Journal Entry Date"), Fecha de
                     contabilizacion, Proveedor y Clase de documento
                     (AccountingDocumentType = "Journal Entry Type").
                     PENDIENTE: Tax Code no existe en el servicio (la vista
                     ENRICHED agrupa por documento y no expone TaxCode). -->
                <Annotation Term="UI.SelectionFields">
                    <Collection>
                        <PropertyPath>AccountingDocument</PropertyPath>
                        <PropertyPath>FiscalPeriod</PropertyPath>
                        <PropertyPath>DocumentDate</PropertyPath>
                        <PropertyPath>PostingDate</PropertyPath>
                        <PropertyPath>Supplier</PropertyPath>
                        <PropertyPath>AccountingDocumentType</PropertyPath>
                    </Collection>
                </Annotation>

                <Annotation Term="UI.HeaderInfo">
                    <Record Type="UI.HeaderInfoType">
                        <PropertyValue Property="TypeName"
                                       String="Libro de Compras"/>
                        <PropertyValue Property="TypeNamePlural"
                                       String="Libro de Compras"/>
                        <PropertyValue Property="Title">
                            <Record Type="UI.DataField">
                                <PropertyValue Property="Value"
                                               Path="AccountingDocument"/>
                            </Record>
                        </PropertyValue>
                    </Record>
                </Annotation>

                <!-- TABLA: Columnas del reporte (C01..C15 se renombran dinamicamente) -->
                <Annotation Term="UI.LineItem">
                    <Collection>
                        <!-- Orden del Libro de Compras (el "#" correlativo solo existe en el PDF) -->
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="DocumentDate"/>
                            <PropertyValue Property="Label" String="DÍA"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="TipDocSat"/>
                            <PropertyValue Property="Label" String="TIPO"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Serie"/>
                            <PropertyValue Property="Label" String="SERIE"/>
                            <!-- Ancho fijo (~15 caracteres): evita el ancho automatico (hasta 20rem) -->
                            <Annotation Term="HTML5.CssDefaults">
                                <Record Type="HTML5.CssDefaultsType">
                                    <PropertyValue Property="width" String="10.5rem"/>
                                </Record>
                            </Annotation>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="DocumentReferenceID"/>
                            <PropertyValue Property="Label" String="NO. DOCUMENTO"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Nit"/>
                            <PropertyValue Property="Label" String="NIT"/>
                            <!-- Ancho fijo (~12 caracteres): evita el ancho automatico (hasta 20rem) -->
                            <Annotation Term="HTML5.CssDefaults">
                                <Record Type="HTML5.CssDefaultsType">
                                    <PropertyValue Property="width" String="9rem"/>
                                </Record>
                            </Annotation>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Proveedor"/>
                            <PropertyValue Property="Label" String="PROVEEDOR"/>
                        </Record>
                        <!-- Columnas dinamicas (se renombran/ocultan segun TablaParametros) -->
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C01"/>
                            <PropertyValue Property="Label" String="C01"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C02"/>
                            <PropertyValue Property="Label" String="C02"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C03"/>
                            <PropertyValue Property="Label" String="C03"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C04"/>
                            <PropertyValue Property="Label" String="C04"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C05"/>
                            <PropertyValue Property="Label" String="C05"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C06"/>
                            <PropertyValue Property="Label" String="C06"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C07"/>
                            <PropertyValue Property="Label" String="C07"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C08"/>
                            <PropertyValue Property="Label" String="C08"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C09"/>
                            <PropertyValue Property="Label" String="C09"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C10"/>
                            <PropertyValue Property="Label" String="C10"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C11"/>
                            <PropertyValue Property="Label" String="C11"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C12"/>
                            <PropertyValue Property="Label" String="C12"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C13"/>
                            <PropertyValue Property="Label" String="C13"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C14"/>
                            <PropertyValue Property="Label" String="C14"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="C15"/>
                            <PropertyValue Property="Label" String="C15"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="ImporteIVA"/>
                            <PropertyValue Property="Label" String="IVA"/>
                        </Record>
                        <Record Type="UI.DataField">
                            <PropertyValue Property="Value" Path="Total"/>
                            <PropertyValue Property="Label" String="TOTAL"/>
                        </Record>
                        <!-- "No. PROVEEDOR" (NoProveedor) y "Nro. Documento FI"
                             (AccountingDocument) ya NO forman parte del reporte
                             inicial. El usuario puede agregarlos desde el engranaje
                             (Configuracion > Columnas); el PDF los sigue incluyendo. -->
                    </Collection>
                </Annotation>

                <!-- ORDEN INICIAL: ascendente por la columna DIA (DocumentDate).
                     AccountingDocument desempata para que el orden (y la
                     paginacion) sea siempre estable. El usuario puede cambiarlo
                     desde el engranaje (Configuracion > Ordenar). -->
                <Annotation Term="UI.PresentationVariant">
                    <Record Type="UI.PresentationVariantType">
                        <PropertyValue Property="SortOrder">
                            <Collection>
                                <Record Type="Common.SortOrderType">
                                    <PropertyValue Property="Property" PropertyPath="DocumentDate"/>
                                    <PropertyValue Property="Descending" Bool="false"/>
                                </Record>
                                <Record Type="Common.SortOrderType">
                                    <PropertyValue Property="Property" PropertyPath="AccountingDocument"/>
                                    <PropertyValue Property="Descending" Bool="false"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                        <PropertyValue Property="Visualizations">
                            <Collection>
                                <AnnotationPath>@UI.LineItem</AnnotationPath>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- Etiqueta del filtro/columna Nº Documento -->
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.TaxReportEnrichedType/AccountingDocument">
                <Annotation Term="Common.Label" String="Nº Documento"/>
            </Annotations>

            <!-- TIPO: en el detalle se muestra SOLO el codigo SAT ("FEL"), sin descripcion.
                 La descripcion concatenada ("FACTURA (FACT)") se arma en el controller solo
                 para el layout "Total por Tipo de Documento" (formatTypeLabel). -->

            <!-- AYUDA DE BUSQUEDA (value help) de Sociedad: el parametro
                 P_CompanyCode no trae ValueList desde el backend, se enlaza
                 a la entidad I_CompanyCode que el servicio ya expone. -->
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.TaxReportEnrichedParameters/P_CompanyCode">
                <Annotation Term="Common.ValueList">
                    <Record Type="Common.ValueListType">
                        <PropertyValue Property="Label" String="Company Code"/>
                        <PropertyValue Property="CollectionPath" String="I_CompanyCode"/>
                        <PropertyValue Property="SearchSupported" Bool="true"/>
                        <PropertyValue Property="Parameters">
                            <Collection>
                                <Record Type="Common.ValueListParameterInOut">
                                    <PropertyValue Property="LocalDataProperty" PropertyPath="P_CompanyCode"/>
                                    <PropertyValue Property="ValueListProperty" String="CompanyCode"/>
                                </Record>
                                <Record Type="Common.ValueListParameterDisplayOnly">
                                    <PropertyValue Property="ValueListProperty" String="CompanyCodeName"/>
                                </Record>
                                <Record Type="Common.ValueListParameterDisplayOnly">
                                    <PropertyValue Property="ValueListProperty" String="CityName"/>
                                </Record>
                                <Record Type="Common.ValueListParameterDisplayOnly">
                                    <PropertyValue Property="ValueListProperty" String="Country"/>
                                </Record>
                            </Collection>
                        </PropertyValue>
                    </Record>
                </Annotation>
            </Annotations>

            <!-- Las copias "normales" de los parametros (columnas clave de la
                 entidad de resultados) no deben ofrecerse como filtros. -->
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.TaxReportEnrichedType/P_CompanyCode">
                <Annotation Term="UI.HiddenFilter" Bool="true"/>
            </Annotations>
            <Annotations Target="cds_ymqaf_sb_taxrpt_enrich_v2.TaxReportEnrichedType/P_FiscalYear">
                <Annotation Term="UI.HiddenFilter" Bool="true"/>
            </Annotations>

        </Schema>
    </edmx:DataServices>
</edmx:Edmx>
