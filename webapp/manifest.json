{
  "_version": "1.58.0",
  "sap.app": {
    "id": "yatl01.reportecolumnasdinamicas",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.2"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "63305533-c0f6-4154-935f-0400f57f3ccd"
    },
    "dataSources": {
      "mainService": {
        "uri": "/sap/opu/odata/sap/YMQAF_SB_TAXRPT_ENRICH_V2;v=2/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "2.0"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "TaxReport-display": {
          "semanticObject": "TaxReport",
          "action": "display",
          "title": "{{appTitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.ui.comp": {},
        "sap.f": {},
        "sap.suite.ui.generic.template": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "yatl01.reportecolumnasdinamicas.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay",
          "defaultCountMode": "Inline",
          "refreshAfterChange": false
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.suite.ui.generic.template.ListReport.view.ListReport": {
            "controllerName": "yatl01.reportecolumnasdinamicas.ext.controller.TaxReportEnrichedListExtension",
            "sap.ui.generic.app": {
              "TaxReportEnrichedSet": {
                "EntitySet": "TaxReportEnrichedSet",
                "Actions": {
                  "exportPdfBackend": {
                    "id": "exportPdfBackendButton",
                    "text": "{i18n>pdfBackendButtonText}",
                    "press": "onExportPdfBackend",
                    "requiresSelection": false
                  }
                }
              }
            }
          }
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "config": {
      "libroFiscal": {
        "_descripcion": "Configuracion del libro fiscal (Compras GT). Es lo UNICO que cambia en el codigo al replicar el libro para otro pais/cliente/tipo. Ver docs/replicar-libro.md",
        "tipoImpuesto": "V",
        "parametros": {
          "entitySet": "TablaParametros",
          "campoSociedad": "Sociedad",
          "campoTipoImpuesto": "TaxType",
          "campoColumna": "FieldName",
          "campoDescripcion": "DescripcionGrup"
        },
        "filtros": {
          "sociedad": "P_CompanyCode",
          "ejercicio": "P_FiscalYear",
          "periodo": "FiscalPeriod"
        },
        "campos": {
          "sociedad": "CompanyCode",
          "documento": "AccountingDocument",
          "ejercicio": "FiscalYear",
          "tipoDocumento": "TipDocSat",
          "descripcionTipoDocumento": "DescTipoDocumento",
          "indicadorImpuesto": "TaxCode",
          "nombreIndicadorImpuesto": "TaxCodeName",
          "posicionImpuesto": "TaxItem",
          "iva": "ImporteIVA",
          "total": "Total",
          "moneda": "CompanyCodeCurrency"
        },
        "camposFecha": ["DocumentDate", "PostingDate"],
        "columnaFija": "DocumentReferenceID",
        "columnasPermitidas": [
          "DocumentDate", "TipDocSat", "Serie", "DocumentReferenceID", "AccountingDocument",
          "Nit", "Proveedor", "ImporteIVA", "Total",
          "Supplier", "PostingDate", "FiscalPeriod", "AccountingDocumentType", "FiscalYear",
          "TaxItem", "TaxCode", "TaxCodeName", "SupplierPoliza",
          "DescTipoDocumento", "CompanyCode", "TrataEspecialPoliza"
        ],
        "anchoColumnas": {
          "Nit": "9rem",
          "Serie": "10.5rem",
          "TipDocSat": "5rem"
        },
        "anchoColumnasScroll": {
          "DocumentDate": "7rem",
          "DocumentReferenceID": "9rem",
          "Proveedor": "18rem",
          "ImporteIVA": "8rem",
          "Total": "9rem",
          "NoProveedor": "8.5rem",
          "AccountingDocument": "9rem"
        },
        "anchoColumnaScrollPorDefecto": "9rem",
        "ordenInicial": ["DocumentDate", "AccountingDocument"],
        "drilldown": {
          "campo": "AccountingDocument",
          "destinos": [
            {
              "texto": "drillAnalyzer",
              "hash": "AccountingDocument-analyzeGLLineItem?AccountingDocument={AccountingDocument}&CompanyCode={CompanyCode}&FiscalYear={FiscalYear}"
            },
            {
              "texto": "drillManage",
              "hash": "AccountingDocument-manageV2&/C_ManageJournalEntryTP(CompanyCode='{CompanyCode}',FiscalYear='{FiscalYear}',AccountingDocument='{AccountingDocument}')/"
            },
            {
              "texto": "drillDisplay",
              "hash": "AccountingDocument-displayDocument?AccountingDocument={AccountingDocument}&CompanyCode={CompanyCode}&FiscalYear={FiscalYear}"
            },
            {
              "texto": "drillGLItems",
              "hash": "GLAccount-displayGLLineItemReportingView?AccountingDocument={AccountingDocument}&CompanyCode={CompanyCode}&FiscalYear={FiscalYear}"
            }
          ]
        },
        "pdf": {
          "servicio": "/sap/opu/odata/sap/YMQA13FISB002/",
          "accion": "generarPdf",
          "entitySet": "PdfStream",
          "propiedadMedia": "PdfData",
          "nombreArchivoPorDefecto": "libro de compras.pdf",
          "parametros": {
            "CompanyCode": "sociedad",
            "FiscalYear": "ejercicio",
            "FiscalPeriod": "periodo"
          }
        }
      }
    }
  },
  "sap.ui.generic.app": {
    "_version": "1.3.0",
    "settings": {
      "forceGlobalRefresh": false,
      "objectPageHeaderType": "Dynamic",
      "considerAnalyticalParameters": true,
      "showDraftToggle": false
    },
    "pages": {
      "ListReport|TaxReportEnrichedSet": {
        "entitySet": "TaxReportEnrichedSet",
        "component": {
          "name": "sap.suite.ui.generic.template.ListReport",
          "list": true,
          "settings": {
            "smartVariantManagement": false,
            "variantManagementHidden": false,
            "tableSettings": {
              "type": "ResponsiveTable"
            }
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
